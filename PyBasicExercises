# Easter.py

day = 0
month = 0
inpYear = int(input("Input a year between 1900 and 2099: "))

while inpYear >= 0:

    if 1900 <= inpYear <= 2099:
        valueD = inpYear - 1900
        valueR = valueD % 19
        valueP = (7 * valueR + 1) // 19
        valueS = (11 * valueR + 4 - valueP) % 29
        valueQ = valueD // 4
        valueT = (valueD + valueQ + 31 - valueS) % 7
        monthRule = (25 - valueS - valueT)
        if monthRule > 0:
            day = monthRule
            month = "April"
            print("(Western) Easter Sunday -", day, month, ",", inpYear)
        else:
            day = 31 + monthRule
            month = "March"
            print("(Western) Easter Sunday -", day, month, ",", inpYear)
        inpYear = int(input("Input another year between 1900 and 2099: "))
    else:
        inpYear = int(input("The year must be BETWEEN 1900 and 2099: "))

print("Bye...")

