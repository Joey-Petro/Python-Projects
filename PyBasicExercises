# Exercise 5.20
import random


def game():

    value = random.randint(1, 100)
    guesses = 0
    number = 0
    while number != value:
        number = int(input("Try and guess the random number: "))
        guesses += 1
        if number < value:
            print("Too low, try again: ")
        if number > value:
            print("Too high, try again: ")
        if number == value:
            print(number, "is correct!!! It only took you", guesses, "tries!")
            print("A new number has been generated, so try and guess it!")
            value = random.randint(1, 100)
            number = 0
            guesses = 0


game()

