# Exercise 5.15

def tests():
    test_one = int(input("Please enter the first score: "))
    test_two = int(input("Please enter the second score: "))
    test_three = int(input("Please enter the third score: "))
    test_four = int(input("Please enter the fourth score: "))
    test_five = int(input("Please enter the fifth score: "))

    def calc_average(first, second, third, fourth, fifth):
        average = (first + second + third + fourth + fifth) / 5
        return average

    def determine_grade(score):
        if score < 60:
            grade = "F"
        if score >= 60 and score <= 69:
            grade = "D"
        if score >= 70 and score <= 79:
            grade = "C"
        if score >= 80 and score <= 89:
            grade = "D"
        if score >= 90:
            grade = "A"
        return grade

    print("\nScore \t Grade")
    grade = determine_grade(test_one)
    print(test_one, "\t", grade)
    grade = determine_grade(test_two)
    print(test_two, "\t", grade)
    grade = determine_grade(test_three)
    print(test_three, "\t", grade)
    grade = determine_grade(test_four)
    print(test_four, "\t", grade)
    grade = determine_grade(test_five)
    print(test_five, "\t", grade)

    total_average = calc_average(test_one, test_two, test_three, test_four, test_five)

    print("Your Average Score Was", total_average)


tests()

